# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================
# These are injected at build time by GitHub Actions
# DO NOT commit actual values - use GitHub Secrets instead

# ImageKit Configuration (Public - safe to expose in frontend)
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
IMAGEKIT_AUTH_ENDPOINT=https://your-backend.vercel.app/api/imagekit-auth

# Optional: Analytics, etc.
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX